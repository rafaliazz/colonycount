# colonycount configuration. Copy to .env (git-ignored) and change only what you need.
# Precedence: CLI flag / function argument > environment variable > .env > the default below.
# An empty value means "use the default". .env is read by the CLI and train/ scripts, from the
# working directory; the Python library (colonycount.count) reads only real environment variables.
# The inference tile size is not a setting: it is read from the ONNX model's input shape.

# --- inference ---------------------------------------------------------------------------
# Score threshold for a detection to count, 0..1 (--threshold, count(threshold=)).
COLONYCOUNT_THRESHOLD=0.5
# Overlap between neighbouring tiles in pixels; must be below the model's tile size.
COLONYCOUNT_TILE_OVERLAP=64
# IoU above which NMS merges two boxes, 0..1.
COLONYCOUNT_NMS_IOU=0.5
# Longest side, in pixels, of the downscaled copy used to find the plate rim.
COLONYCOUNT_PLATE_SEARCH_SIZE=512

# --- models / CLI --------------------------------------------------------------------------
# Built-in model name (--model, count(model=)); see `colonycount --list-models`.
COLONYCOUNT_MODEL=public
# Local ONNX file used instead of the built-in model (--model-path, count(model_path=)).
COLONYCOUNT_MODEL_PATH=
# Where downloaded model weights are cached; empty = the platform's user cache directory.
COLONYCOUNT_CACHE_DIR=
# Countable range LOW,HIGH for the TFTC/TNTC flag (--range).
COLONYCOUNT_COUNTABLE_RANGE=30,300

# --- data ----------------------------------------------------------------------------------
# Root of the prepared datasets (train/ scripts --data-dir, tests/test_public_data.py).
COLONYCOUNT_DATA_DIR=~/data/colonycount
# train/val/test fractions for prepare_public.py's group split.
COLONYCOUNT_SPLIT_FRACTIONS=0.70,0.15,0.15
# Images taken out of smartphone train into the adaptation pool.
COLONYCOUNT_ADAPT_SIZE=20

# --- training ------------------------------------------------------------------------------
# Training tile size in pixels (make_tiles.py tiles, RF-DETR resolution); export must match.
COLONYCOUNT_TRAIN_TILE_SIZE=640
# Minimum fraction of a box's area inside a tile for make_tiles.py to keep it.
COLONYCOUNT_TILE_MIN_INSIDE=0.5
# Random seed for splits, tile sampling and training.
COLONYCOUNT_SEED=0
# Training epochs (--epochs; RF-DETR, YOLO, YOLOX), per-step batch (--batch-size), grad accum.
# Their product (16) is the effective batch of RF-DETR, YOLO (Ultralytics' nbs) and YOLOX.
COLONYCOUNT_TRAIN_EPOCHS=12
COLONYCOUNT_TRAIN_BATCH_SIZE=2
COLONYCOUNT_TRAIN_GRAD_ACCUM=8

# --- secrets (only in .env or CI secrets, never committed) -------------------------------
# Hugging Face token for publishing model weights later; not read by any code yet.
HF_TOKEN=
